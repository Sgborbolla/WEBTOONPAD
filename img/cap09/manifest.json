  },
  {
   "pantalla": 26,
   "panel": 2,
   "quien": "",
   "texto": "Eso.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 29,
   "panel": 1,
   "quien": "",
   "texto": "Horas.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 29,
   "panel": 2,
   "quien": "",
   "texto": "Llevo horas sin música.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 35,
   "panel": 1,
   "quien": "",
   "texto": "Goro.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 35,
   "panel": 2,
   "quien": "",
   "texto": "No cruces.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 36,
   "panel": 1,
   "quien": "",
   "texto": "Lo sé.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 36,
   "panel": 2,
   "quien": "",
   "texto": "No cruzo.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 43,
   "panel": 1,
   "quien": "",
   "texto": "Podría dispararle.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 44,
   "panel": 1,
   "quien": "",
   "texto": "¿Dispararle a qué?",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 44,
   "panel": 2,
   "quien": "",
   "texto": "A esa cosa.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 45,
   "panel": 1,
   "quien": "",
   "texto": "Desde aquí se ve bien. El mercado. El pasillo. Dónde se paró. Podría dispararle.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 45,
   "panel": 2,
   "quien": "",
   "texto": "No había que dispararle.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 45,
   "panel": 3,
   "quien": "",
   "texto": "No hay que dispararle a nada. Hasta ayer había que disparar a todo. Hoy no hay que dispararle a nada. ¿Quién ha cambiado las reglas?",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 49,
   "panel": 1,
   "quien": "",
   "texto": "Horas.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 49,
   "panel": 2,
   "quien": "",
   "texto": "Horas sin música. Y no pasa nada.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 50,
   "panel": 1,
   "quien": "",
   "texto": "No pasa nada.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 53,
   "panel": 1,
   "quien": "",
   "texto": "Se fue.",
   "globo": "abajo-izq",
