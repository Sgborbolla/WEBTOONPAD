 "dialogos": [
  {
   "pantalla": 1,
   "panel": 2,
   "quien": "",
   "texto": "Cuatro y veinte. Cuatro y media abre el otro.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 1,
   "panel": 2,
   "quien": "",
   "texto": "Seis y ahí se van todos. Menudo turno.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 1,
   "quien": "",
   "texto": "Oye. ¿Está el de arriba?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 1,
   "quien": "",
   "texto": "Todavía no, Arashi-san.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 2,
   "quien": "",
   "texto": "Arashi-san. La puerta del cuatro hace un ruido raro.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 2,
   "quien": "",
   "texto": "Raro como.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 2,
   "quien": "",
   "texto": "Como un... soplido. Cada ciertos minutos.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 2,
   "quien": "",
   "texto": "Cada cuanto.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 2,
   "quien": "",
   "texto": "No se. Dos, tres minutos.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 1,
   "quien": "",
   "texto": "Hay un parte. Si algo no encaja, se escribe.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 1,
   "quien": "",
   "texto": "Si. Claro.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 1,
   "quien": "",
   "texto": "¿Y si encaja?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 1,
   "quien": "",
   "texto": "Entonces no se escribe. No se molesta.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 2,
   "quien": "",
   "texto": "Lo escribo entonces.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 2,
   "quien": "",
   "texto": "Bien.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 2,
   "quien": "",
   "texto": "¿Y usted lo ha visto alguna vez, Arashi-san? ¿Un soplido?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 2,
   "quien": "",
   "texto": "No.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 4,
   "panel": 2,
   "quien": "",
   "texto": "Llegas tarde.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 4,
   "panel": 2,
   "quien": "",
   "texto": "Llego a mi hora.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 4,
   "panel": 2,
   "quien": "",
   "texto": "Todos llegas a tu hora.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 4,
   "panel": 2,
   "quien": "",
   "texto": "¿Eso es un elogio?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 1,
   "quien": "",
   "texto": "Bajar eso al contenedor.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 1,
   "quien": "",
   "texto": "Esta pesado.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 1,
   "quien": "",
   "texto": "Por eso lo bajamos.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 1,
   "quien": "",
   "texto": "Aparte, hay un bicho raro en el dos.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 1,
   "quien": "",
   "texto": "¿Un bicho?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 1,
   "quien": "",
   "texto": "Grande. Amarillo. No es perro.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 2,
   "quien": "",
   "texto": "Subo yo.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 2,
   "quien": "",
   "texto": "Y yo hago de comer.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 2,
   "quien": "",
   "texto": "Grande, ¿eh?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 2,
   "quien": "",
   "texto": "Grande grande. En el pasillo. O no estaba.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 2,
   "quien": "",
   "texto": "(pausa) ¿En el pasillo?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 2,
   "quien": "",
   "texto": "Eso he dicho.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 6,
   "panel": 1,
   "quien": "",
   "texto": "Y guiso bien hoy.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 6,
   "panel": 1,
   "quien": "",
   "texto": "Guisas bien todos los días.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 6,
   "panel": 1,
   "quien": "",
   "texto": "Guiso bien todos los días y nunca te lo comes.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 9,
   "panel": 1,
   "quien": "",
   "texto": "(nada)",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 10,
   "panel": 1,
   "quien": "",
   "texto": "Yo no veo nada.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 10,
   "panel": 1,
   "quien": "",
   "texto": "Espera.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 10,
   "panel": 1,
   "quien": "",
   "texto": "Arashi-san, no se ve nada.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 10,
   "panel": 2,
   "quien": "",
   "texto": "Bueno. Voy a... voy a avisar.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 10,
   "panel": 2,
   "quien": "",
   "texto": "Corre.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 12,
   "panel": 2,
   "quien": "",
   "texto": "(murmura) Cosas raras.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 14,
   "panel": 1,
   "quien": "",
   "texto": "Hey. (pausa) Hey, ¿estás bien?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 15,
   "panel": 1,
   "quien": "",
   "texto": "No vengas. Te digo que no vengas.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 17,
   "panel": 2,
   "quien": "",
   "texto": "Arashi. ¿Comes ahora o...",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 18,
   "panel": 1,
   "quien": "",
   "texto": "¿Qué pasó ahí?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 18,
   "panel": 1,
   "quien": "",
   "texto": "Nada.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  }
