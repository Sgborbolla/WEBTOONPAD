 "dialogos": [
  {
   "pantalla": 14,
   "panel": 1,
   "quien": "",
   "texto": "Llegan tarde a todo.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 14,
   "panel": 2,
   "quien": "",
   "texto": "Hable claro.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 18,
   "panel": 1,
   "quien": "",
   "texto": "Quiero ver el expediente.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 18,
   "panel": 2,
   "quien": "",
   "texto": "No existe.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 19,
   "panel": 1,
   "quien": "",
   "texto": "Existe. Lo tiene usted.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 20,
   "panel": 1,
   "quien": "",
   "texto": "Usted no nos ha dicho todo.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 20,
   "panel": 2,
   "quien": "",
   "texto": "No puedo decirlo todo.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 22,
   "panel": 1,
   "quien": "",
   "texto": "Esto huele a tapado.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 23,
   "panel": 3,
   "quien": "",
   "texto": "Ahí está.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 25,
   "panel": 2,
   "quien": "",
   "texto": "Ese nombre.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 29,
   "panel": 1,
   "quien": "",
   "texto": "Esto es lo que busca todo el mundo.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 29,
   "panel": 2,
   "quien": "",
   "texto": "Esto es lo que queda.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 30,
   "panel": 1,
   "quien": "",
   "texto": "El sello de antes. Coincide.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 32,
   "panel": 1,
   "quien": "",
   "texto": "Habla de omega.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 32,
   "panel": 2,
   "quien": "",
   "texto": "Estado. No enemigo.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 33,
   "panel": 1,
   "quien": "",
   "texto": "¿Estado desde cuándo?",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 33,
   "panel": 2,
   "quien": "",
   "texto": "Demasiado tiempo.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 35,
   "panel": 1,
   "quien": "",
   "texto": "Mio Tsukimi. ¿Está aquí?",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 36,
   "panel": 1,
   "quien": "",
   "texto": "No está en esta carpeta.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 36,
   "panel": 2,
   "quien": "",
   "texto": "Pero existe en otra.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 37,
   "panel": 2,
   "quien": "",
   "texto": "Déjeme ver todo.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 37,
   "panel": 3,
   "quien": "",
   "texto": "No puedo. Aún no.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 39,
