 "dialogos": [
  {
   "pantalla": 1,
   "panel": 2,
   "quien": "",
   "texto": "Dos días. La puerta no vuelve. Y sigue creciendo.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 1,
   "quien": "",
   "texto": "(murmura) Ni el sargento ni nadie. Ni el capitan me contesto.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 1,
   "quien": "",
   "texto": "¿La abriste más?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 1,
   "quien": "",
   "texto": "No. Se abrio sola.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 2,
   "quien": "",
   "texto": "¿Y la guardia?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 2,
   "quien": "",
   "texto": "Se fue ayer. No es que no vengan, Arashi-san. Es que no vienen.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 2,
   "quien": "",
   "texto": "Anotado.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 1,
   "quien": "",
   "texto": "Siéntate bien.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 1,
   "quien": "",
   "texto": "Estoy bien, jefe.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 1,
   "quien": "",
   "texto": "Nadie te preguntó.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 2,
   "quien": "",
   "texto": "Arashi me cubrió. A los dos nos quemamos.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 2,
   "quien": "",
   "texto": "¿Qué?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 2,
   "quien": "",
   "texto": "El fuego. Lo que salía.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 6,
   "panel": 1,
   "quien": "",
   "texto": "Que salía.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 6,
   "panel": 1,
   "quien": "",
   "texto": "(se gira) Arashi. No es nada. Ya está.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 6,
   "panel": 1,
   "quien": "",
   "texto": "(mira la venda) Eso es una quemadura de third grado.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 6,
   "panel": 1,
   "quien": "",
   "texto": "Que se te va a curar.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 6,
   "panel": 2,
   "quien": "",
   "texto": "Bien, sentaos los dos. Que se enfría.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 6,
   "panel": 2,
   "quien": "",
   "texto": "No tengo hambre.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 6,
   "panel": 2,
   "quien": "",
   "texto": "Nadie te lo pregunto.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 9,
   "panel": 1,
   "quien": "",
   "texto": "¿Kiryu. ¿Lo ves?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 9,
   "panel": 1,
   "quien": "",
   "texto": "Veo la calle.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 9,
   "panel": 1,
   "quien": "",
   "texto": "No. En el suelo.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 9,
   "panel": 2,
   "quien": "",
   "texto": "...Eso estaba antes.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 9,
   "panel": 2,
   "quien": "",
   "texto": "¿Como antes?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 9,
   "panel": 2,
   "quien": "",
   "texto": "No lo sé. Es largo. Es como una sombra.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 10,
   "panel": 1,
   "quien": "",
   "texto": "No te muevas.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 10,
   "panel": 1,
   "quien": "",
   "texto": "Arashi-san...",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 13,
   "panel": 1,
   "quien": "",
   "texto": "Arashi-san. Arashi-san. Arashi-san.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 14,
   "panel": 1,
   "quien": "",
   "texto": "Nomura.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 14,
   "panel": 1,
   "quien": "",
   "texto": "Tsumita-san.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 14,
   "panel": 2,
   "quien": "",
   "texto": "¿Qué le ha pasado?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 14,
   "panel": 2,
   "quien": "",
   "texto": "Yo.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 14,
   "panel": 2,
   "quien": "",
   "texto": "¿Tú qué?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 14,
   "panel": 2,
   "quien": "",
   "texto": "Yo le he pasado.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 15,
   "panel": 1,
   "quien": "",
   "texto": "Ha dicho que lo tapaba. Que salía.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 15,
   "panel": 1,
   "quien": "",
   "texto": "Sale. Ya lo sé. Arashi, yo lo he visto salir.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 15,
   "panel": 1,
   "quien": "",
   "texto": "¿Cuántas veces?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 15,
   "panel": 1,
   "quien": "",
   "texto": "(pausa) Tres veces.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 16,
   "panel": 1,
   "quien": "",
   "texto": "Con Acero gris, tres personas. Dos salidas. Uno no responded.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 18,
   "panel": 1,
   "quien": "",
   "texto": "No me lo vuelvo a poner.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  }
 ]
}