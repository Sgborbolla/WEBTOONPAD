   "cola": "abajo-dcha"
  },
  {
   "pantalla": 11,
   "panel": 2,
   "quien": "",
   "texto": "Coordinacion.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 11,
   "panel": 2,
   "quien": "",
   "texto": "Aereo. Solo aereo.",
