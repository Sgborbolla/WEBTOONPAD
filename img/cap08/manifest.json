 "dialogos": [
  {
   "pantalla": 15,
   "panel": 1,
   "quien": "",
   "texto": "¿Qué eres?",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 16,
   "panel": 1,
   "quien": "",
   "texto": "¡No!",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 23,
   "panel": 1,
   "quien": "",
   "texto": "Mio. Hago esto por Mio.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 27,
   "panel": 2,
   "quien": "",
   "texto": "Ya sabía que estabas ahí.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 29,
   "panel": 1,
   "quien": "",
   "texto": "No ibas a volver sola.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 29,
   "panel": 1,
   "quien": "",
   "texto": "Volví sola.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 29,
   "panel": 1,
   "quien": "",
   "texto": "Y ganaste sola.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 29,
   "panel": 2,
   "quien": "",
   "texto": "Otra cosa no pude hacer.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 29,
   "panel": 2,
   "quien": "",
   "texto": "Estabas siguiéndome.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 30,
   "panel": 3,
   "quien": "",
   "texto": "Goro. Yui. ¿Sabes?",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 30,
   "panel": 3,
   "quien": "",
   "texto": "Están a dos calles. No saben. Yo no les dije.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 32,
   "panel": 2,
   "quien": "",
   "texto": "No se lo digas.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 33,
   "panel": 1,
   "quien": "",
   "texto": "No se lo digo.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 35,
   "panel": 1,
   "quien": "",
   "texto": "¿Qué hay al fondo?",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 35,
   "panel": 1,
   "quien": "",
   "texto": "Un hueco grande. Más grande que el de la guardería.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 35,
   "panel": 2,
   "quien": "",
   "texto": "Todavía no se abre.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 36,
   "panel": 1,
   "quien": "",
   "texto": "¿Lo has visto?",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 36,
   "panel": 2,
   "quien": "",
   "texto": "Lo he visto. Ahora, al volver. Está un poco más allá del portal.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 36,
   "panel": 3,
   "quien": "",
   "texto": "Es como si esperara.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 40,
   "panel": 1,
   "quien": "",
   "texto": "Hay un hueco grande al fondo.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 40,
   "panel": 1,
   "quien": "",
   "texto": "Ya lo sé.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 40,
   "panel": 1,
   "quien": "",
   "texto": "No se abre.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 40,
   "panel": 1,
   "quien": "",
   "texto": "Todavía.",
   "globo": "abajo-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 42,
