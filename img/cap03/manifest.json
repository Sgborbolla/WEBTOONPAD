 "dialogos": [
  {
   "pantalla": 2,
   "panel": 1,
   "quien": "",
   "texto": "Unidad seis, habla Arashi. Una puerta abierta en mi pasillo.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 1,
   "quien": "",
   "texto": "Sector seis, recibido. ¿Abierta o forzada?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 1,
   "quien": "",
   "texto": "Abierta.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 1,
   "quien": "",
   "texto": "Un momento.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 2,
   "quien": "",
   "texto": "Sector seis, no tenemos registro de eso.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 2,
   "quien": "",
   "texto": "Registro.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 2,
   "panel": 2,
   "quien": "",
   "texto": "Un parte, sr. Arashi. Si es una puerta sin número, no hay sector.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 1,
   "quien": "",
   "texto": "¿Y si hay algo adentro?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 1,
   "quien": "",
   "texto": "No lo preveo.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 1,
   "quien": "",
   "texto": "...No se prevee nada de este tipo.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 1,
   "quien": "",
   "texto": "Manda a alguien.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 3,
   "panel": 1,
   "quien": "",
   "texto": "Cuando pueda, sr. Arashi.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 4,
   "panel": 2,
   "quien": "",
   "texto": "(resopla)",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 1,
   "quien": "",
   "texto": "Setsuko-san. ¿Ha oido la alarma?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 1,
   "quien": "",
   "texto": "¿Qué alarma?",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 1,
   "quien": "",
   "texto": "No ha sonado. Va a sonar.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 2,
   "quien": "",
   "texto": "Esto es el Sector 6. A las seis cierran.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 2,
   "quien": "",
   "texto": "Setsuko-san, por favor, vaya a su casa.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 5,
   "panel": 2,
   "quien": "",
   "texto": "Pero si mi carro...",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 11,
   "panel": 1,
   "quien": "",
   "texto": "Dios mio. Dios mio.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 11,
   "panel": 2,
   "quien": "",
   "texto": "(grito corto)",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
   "pantalla": 12,
   "panel": 1,
   "quien": "",
   "texto": "Mamá.",
   "globo": "arriba-izq",
   "cola": "abajo-dcha"
  },
  {
